# ══════════════════════════════════════════════════════════════════════════
#  Production environment — copy to .env and fill in.
#
#      cp .env.example .env && $EDITOR .env && docker compose up -d --build
#
#  .env is gitignored. Nothing here has a working default on purpose: a
#  deployment that has not been configured should fail to start rather than
#  come up with a known password on a public address.
#
#  Adding, renaming or removing a variable is ONE change that touches this
#  file, backend/config/custom-environment-variables.json, the compose
#  service's environment block, and the config default when there is one.
#  `npm run check:env` fails on any partial state.
# ══════════════════════════════════════════════════════════════════════════

# ── Hosts (must resolve to this machine before Let's Encrypt will issue) ──
APP_HOST=app.example.com
API_HOST=api.example.com
ACME_EMAIL=ops@example.com

# ── Session ───────────────────────────────────────────────────────────────
# 32+ random bytes. Changing it signs everybody out, which is the point if it
# ever leaks:  openssl rand -base64 48
JWT_SECRET=
# Leave blank unless the app and the API share a parent domain and the cookie
# must span both. A narrower cookie is a safer cookie.
COOKIE_DOMAIN=

# ── Database ──────────────────────────────────────────────────────────────
MYSQL_DATABASE=acme
MYSQL_USER=acme
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Mail ──────────────────────────────────────────────────────────────────
# Invites and password resets. Without a working relay nobody can be given an
# account, because nobody self-registers.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Acme

# ── The first account ─────────────────────────────────────────────────────
# Created on first boot when the users table is empty. 12 characters minimum;
# the API refuses to start with the default or a short one.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Acme

# ── Noise ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
DB_LOGGING=false

# ══════════════════════════════════════════════════════════════════════════
#  Set by the compose file, NOT here — they follow from the shape of the
#  deployment rather than from a choice. Listed so they are documented where
#  they cannot be set:
#
#    NODE_ENV        production
#    PORT / HOST     3000 for the API, 3010 for web
#    COOKIE_SECURE   true — the session cookie behind TLS
#    APP_URL         https://$APP_HOST, used in invite and reset links
#    CORS_ORIGIN     https://$APP_HOST — exact, because credentials forbid *
#    MAIL_TRANSPORT  smtp. A `console` on a deployed box sends every invite
#                    to a log file.
#    API_ORIGIN      http://api:3000, what the web container proxies to
# ══════════════════════════════════════════════════════════════════════════
